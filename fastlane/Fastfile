fastlane_version "2.60.1"

default_platform :ios

# ---------------------------------------------------------------------------
# Per-repo constants. Everything below this block is kept identical across the
# Car-Connect and PlainTextPaste Fastfiles. Version + build number live in
# Config/base.xcconfig (single source of truth, inherited by every target).
# ---------------------------------------------------------------------------
PROJECT           = "Car-Connect.xcodeproj"
SCHEME            = "Car-Connect"
TEAM_ID           = "NN495VBEDV"
APP_ID            = "com.mkdutton.Car-Connect"
# Every target that ships in the archive, mapped to its bundle identifier.
SIGNED_TARGETS    = { "Car-Connect" => APP_ID }
ALL_IDS           = SIGNED_TARGETS.values
UNIT_TEST_TARGETS = ["Car-ConnectTests"]
TEST_DEVICE       = "iPhone 17 Pro Max"
XCCONFIG          = File.expand_path("../../Config/base.xcconfig", __FILE__)

platform :ios do
  before_all do
    # Authenticate with an App Store Connect API key so signing/upload actions
    # (match, pilot, register_devices) don't fall back to interactive 2FA.
    if !ENV["APP_STORE_CONNECT_KEY_CONTENT"].to_s.empty?
      # CI: key delivered as a base64 secret (no .p8 file on disk)
      app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
        key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
        is_key_content_base64: true,
        in_house: false
      )
    elsif ENV["APP_STORE_CONNECT_KEY_ID"] && ENV["APP_STORE_CONNECT_ISSUER_ID"]
      # Local: key read from fastlane/AuthKey_<KEY_ID>.p8 (values in fastlane/.env.default)
      app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
        key_filepath: File.expand_path("../AuthKey_#{ENV['APP_STORE_CONNECT_KEY_ID']}.p8", __FILE__),
        in_house: false
      )
    end
  end

  desc "Run all unit tests"
  lane :test do
    scan(
      project: PROJECT,
      scheme: SCHEME,
      devices: [TEST_DEVICE],
      only_testing: UNIT_TEST_TARGETS
    )
  end

  desc "Submit a new Beta Build to Apple TestFlight, then commit and push the build number"
  lane :beta do
    increment
    match(type: "appstore", readonly: true)
    gym
    pilot(skip_waiting_for_build_processing: true)
    # Commit only after a successful upload, so the repo never claims a build TestFlight lacks.
    commit_increment(message: "Build number bump [ci skip]")
  end

  desc "CI: build and upload a new build to TestFlight (App Store Connect)"
  lane :ci_beta do
    setup_ci
    match_opts = { type: "appstore", readonly: true }
    # On CI, clone the certs repo over HTTPS; auth is provided by the workflow's git config (url.insteadOf).
    match_opts[:git_url] = "https://github.com/mduttondev/Certificates.git" if ENV["CI"]
    match(match_opts)

    bump_xcconfig_build_number

    if ENV["CI"]
      # Hosted runners can't do automatic signing — pin each target to its match profile.
      SIGNED_TARGETS.each do |target, bundle_id|
        update_code_signing_settings(
          use_automatic_signing: false,
          path: PROJECT,
          team_id: TEAM_ID,
          code_sign_identity: "Apple Distribution",
          profile_name: "match AppStore #{bundle_id}",
          targets: [target]
        )
      end
    end

    gym(
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: ALL_IDS.to_h { |bundle_id| [bundle_id, "match AppStore #{bundle_id}"] }
      }
    )
    pilot(skip_waiting_for_build_processing: true)
  end

  desc "Revoke ONLY expired/dead certs + profiles, then regenerate what is missing (never touches valid ones)"
  lane :resetSigning do
    revoke_expired_signing
    # match now finds the expired items gone and regenerates only those; valid certs/profiles are reused.
    match(type: "development", app_identifier: ALL_IDS, force_for_new_devices: true)
    match(type: "appstore", app_identifier: ALL_IDS)
  end

  # Surgically revoke ONLY expired certificates and delete ONLY dead/expired provisioning
  # profiles on the Dev Portal. Valid, in-use signing is left completely alone (important:
  # this account's distribution cert is shared across apps).
  private_lane :revoke_expired_signing do
    api_key = lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: api_key[:key_id],
      issuer_id: api_key[:issuer_id],
      key: api_key[:key],
      is_key_content_base64: api_key[:is_key_content_base64]
    )
    now = Time.now
    Spaceship::ConnectAPI::Certificate.all.each do |c|
      exp = (Time.parse(c.expiration_date) rescue nil)
      next unless exp && exp < now
      UI.important("Revoking EXPIRED certificate: #{c.display_name} (#{c.serial_number}) — expired #{c.expiration_date}")
      c.delete!
    end
    Spaceship::ConnectAPI::Profile.all.each do |p|
      exp = (Time.parse(p.expiration_date) rescue nil)
      dead = p.profile_state.to_s.upcase != "ACTIVE" || (exp && exp < now)
      next unless dead
      UI.important("Deleting DEAD/EXPIRED profile: #{p.name} — state #{p.profile_state}")
      p.delete!
    end
  end

  # Bump the build number in base.xcconfig (single source of truth) past both the local value and
  # TestFlight's latest; agvtool's increment_build_number would edit the project file instead.
  private_lane :bump_xcconfig_build_number do
    contents = File.read(XCCONFIG)
    current_build = contents[/^\s*CURRENT_PROJECT_VERSION\s*=\s*(\d+)/, 1].to_i
    build_num = [
      current_build + 1,
      latest_testflight_build_number(app_identifier: APP_ID) + 1
    ].max
    File.write(XCCONFIG, contents.gsub(/^(\s*CURRENT_PROJECT_VERSION\s*=\s*).*$/, "\\1#{build_num}"))
    UI.message("Set CURRENT_PROJECT_VERSION=#{build_num} in #{XCCONFIG}")
  end

  desc "Increment the build number and Commit"
  lane :increment do |options|
    bump_xcconfig_build_number

    if options[:commit]
      commit_increment(message: "Build number bump by fastlane - [ios increment] lane")
    end
  end

  desc "Push ./devices.txt to register new devices and create a new profile accordingly"
  lane :deviceRegistration do
    register_devices(devices_file: "./fastlane/devices.txt")
    match(type: "development", app_identifier: ALL_IDS, force_for_new_devices: true)
  end

  ####################################
  ## Convenience Lanes
  ####################################
  desc "Commit and push the build number increase"
  lane :commit_increment do |options|
    message = options[:message] ||= "No commit message specified"
    branch = options[:branch] ||= "main"

    git_commit(path: "Config/base.xcconfig", message: message)

    push_to_git_remote(
      remote: "origin",
      local_branch: branch,
      remote_branch: branch,
      tags: false
    )
  end
end
